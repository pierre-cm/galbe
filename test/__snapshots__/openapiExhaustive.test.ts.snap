"import { $T } from "galbe";

import { Widget } from "../commons.schema";

export const PostMultiBody = {
  body: {
    "application/json": Widget,
    "application/x-www-form-urlencoded": $T.object({
      name: $T.string(),
      count: $T.optional($T.integer()),
    }),
    "multipart/form-data": $T.multipartForm(
      {
        file: $T.byteArray(),
        caption: $T.optional($T.string()),
        tags: $T.optional($T.array($T.string())),
      },
      {
        encoding: {
          file: { contentType: "application/octet-stream" },
          tags: { style: "form", explode: true },
        },
      },
    ),
    "text/plain": $T.string(),
    "application/octet-stream": $T.byteArray(),
  },
  response: { 202: $T.null({ description: "Accepted." }) },
};
"
`;

