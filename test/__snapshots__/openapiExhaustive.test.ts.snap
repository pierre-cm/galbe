"openapi: 3.0.3
info: 
  title: Exhaustive Spec
  description: "Coverage fixture for the OpenAPI parser and serializer.\\n\\nIt contains one endpoint family per construct family: primitives,\\ncomposition, bodies, responses, parameters, security and metadata.\\n"
  contact: 
    name: Spec Bot
    url: https://example.test/contact
    email: spec@example.test
  license: 
    name: MIT
    url: https://opensource.org/licenses/MIT
  version: 4.2.1
  termsOfService: https://example.test/tos
servers: 
  - url: https://api.example.test/v1
    description: Production
  - url: "https://{tenant}.staging.example.test/v1"
    description: "Staging, per tenant"
    variables: 
      tenant: 
        default: acme
        enum: 
          - acme
          - globex
        description: Tenant subdomain
tags: 
  - name: primitives
    description: "Scalar types, formats and constraints."
  - name: composition
    description: allOf / oneOf / anyOf / discriminator.
  - name: bodies
    description: Request body media types.
  - name: responses
    description: "Status codes, headers, examples, links."
  - name: params
    description: Parameter locations and styles.
  - name: security
    description: Security schemes and scopes.
  - name: meta
    description: Operation metadata.
  - name: admin
    description: Deeply nested scope.
security: 
  - bearerAuth: 
      []
externalDocs: 
  url: https://example.test/docs
  description: Full handbook
paths: 
  /composition: 
    post: 
      tags: 
        - composition
      summary: Composed schemas in and out.
      description: "Exercises allOf, oneOf, anyOf, discriminators and deep nesting."
      operationId: composeShapes
      requestBody: 
        required: true
        content: 
          application/json: 
            schema: 
              type: object
              properties: 
                intersected: 
                  allOf: 
                    - $ref: "#/components/schemas/Identified"
                    - $ref: "#/components/schemas/Timestamped"
                union: 
                  oneOf: 
                    - $ref: "#/components/schemas/Cat"
                    - $ref: "#/components/schemas/Dog"
                loose: 
                  anyOf: 
                    - type: string
                    - type: integer
                singleAllOf: 
                  $ref: "#/components/schemas/Identified"
                singleOneOf: 
                  type: string
                negated: 
                  {}
              required: 
                - intersected
                - union
                - loose
      responses: 
        "200": 
          description: The discriminated result.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/Pet"
        "422": 
          $ref: "#/components/responses/ValidationError"
  /composition/nested: 
    get: 
      tags: 
        - composition
      summary: Deeply nested objects and arrays.
      operationId: getNested
      responses: 
        "200": 
          description: A nested tree.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/Nested"
  /composition/nullable: 
    get: 
      tags: 
        - composition
      summary: Nullable in every position.
      operationId: getNullable
      responses: 
        "200": 
          description: Nulls everywhere.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/NullableBag"
  /formats: 
    get: 
      tags: 
        - composition
      summary: "String formats, free-form maps and read/write-only properties."
      operationId: getFormats
      responses: 
        "200": 
          description: The kitchen sink of schema annotations.
          content: 
            application/json: 
              schema: 
                type: object
                properties: 
                  formats: 
                    $ref: "#/components/schemas/StringFormats"
                  map: 
                    $ref: "#/components/schemas/MapObject"
                  readWrite: 
                    $ref: "#/components/schemas/ReadWriteOnly"
                required: 
                  - formats
  /params/shared: 
    get: 
      tags: 
        - params
      summary: "Reuses the same page parameters, so they get promoted."
      operationId: getSharedParams
      parameters: 
        - $ref: "#/components/parameters/Page"
        - $ref: "#/components/parameters/PageSize"
      responses: 
        "200": 
          description: A page.
          content: 
            application/json: 
              schema: 
                type: array
                items: 
                  $ref: "#/components/schemas/Widget"
  "/params/{group}/items/{itemId}": 
    get: 
      tags: 
        - params
      summary: "Path, query, header and cookie parameters together."
      operationId: getParamMatrix
      parameters: 
        - name: group
          in: path
          required: true
          schema: 
            type: string
        - name: itemId
          in: path
          required: true
          schema: 
            type: integer
        - $ref: "#/components/parameters/Page"
        - $ref: "#/components/parameters/PageSize"
        - name: sort
          in: query
          description: "Sort key, defaulted."
          schema: 
            type: string
            enum: 
              - name
              - size
              - createdAt
            default: name
        - name: expand
          in: query
          description: Repeated query parameter.
          schema: 
            type: array
            items: 
              type: string
        - name: filter
          in: query
          description: An object parameter serialized as deepObject.
          style: deepObject
          explode: true
          schema: 
            type: object
            properties: 
              lat: 
                type: number
              lon: 
                type: number
        - name: pipes
          in: query
          description: A pipe-delimited array parameter.
          style: pipeDelimited
          schema: 
            type: array
            items: 
              type: string
        - name: legacy
          in: query
          description: On the way out.
          deprecated: true
          schema: 
            type: string
        - name: contentParam
          in: query
          description: "A parameter typed through \`content\` rather than \`schema\`."
          style: deepObject
          explode: true
          schema: 
            type: object
            properties: 
              lat: 
                type: number
              lon: 
                type: number
        - name: X-Tenant
          in: header
          description: Tenant selector.
          required: true
          schema: 
            type: string
        - name: session
          in: cookie
          description: Session cookie.
          schema: 
            type: string
      responses: 
        "200": 
          description: Matrix echoed back.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/Widget"
  /primitives: 
    get: 
      tags: 
        - primitives
      summary: Every scalar type as a query parameter.
      description: "Covers string/number/integer/boolean/array query parameters with the\\nfull set of JSON Schema constraints Galbe knows how to express."
      operationId: listPrimitives
      parameters: 
        - name: plainString
          in: query
          description: A string with no constraint at all.
          schema: 
            type: string
        - name: boundedString
          in: query
          description: A string with length bounds and a pattern.
          required: true
          schema: 
            type: string
            pattern: "^[a-z][a-z0-9_-]*$"
            minLength: 3
            maxLength: 24
        - name: formattedString
          in: query
          description: A string carrying a format.
          schema: 
            type: string
            format: date-time
        - name: defaultedString
          in: query
          schema: 
            type: string
            default: fallback
        - name: enumString
          in: query
          description: A closed set of string values.
          schema: 
            type: string
            enum: 
              - alpha
              - beta
              - gamma
        - name: singleEnumString
          in: query
          description: "A one-value enum, i.e. a literal."
          schema: 
            type: string
            enum: 
              - only
        - name: boundedInteger
          in: query
          schema: 
            type: integer
            format: int32
            minimum: 0
            maximum: 100
        - name: exclusiveInteger
          in: query
          schema: 
            type: integer
            format: int64
            minimum: 1
            exclusiveMinimum: true
            maximum: 999
            exclusiveMaximum: true
        - name: boundedNumber
          in: query
          schema: 
            type: number
            format: double
            minimum: -1.5
            maximum: 1.5
        - name: multipleOfNumber
          in: query
          schema: 
            type: number
            multipleOf: 0.25
        - name: flag
          in: query
          schema: 
            type: boolean
            default: false
        - name: stringList
          in: query
          description: An array with item bounds and uniqueness.
          schema: 
            type: array
            items: 
              type: string
            minItems: 1
            maxItems: 10
            uniqueItems: true
        - name: enumIntegerList
          in: query
          schema: 
            type: array
            items: 
              type: integer
              enum: 
                - 1
                - 2
                - 3
        - name: anySchema
          in: query
          description: "No type at all, i.e. anything goes."
          schema: 
            {}
      responses: 
        "200": 
          description: A page of primitives.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/PrimitiveBag"
      security: 
        []
  "/primitives/{id}": 
    get: 
      tags: 
        - primitives
      summary: "Read one, inheriting the path-item parameters."
      operationId: getPrimitive
      parameters: 
        - $ref: "#/components/parameters/Id"
        - $ref: "#/components/parameters/XTraceId"
      responses: 
        "200": 
          description: Found.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/PrimitiveBag"
        "404": 
          $ref: "#/components/responses/NotFound"
    put: 
      tags: 
        - primitives
      summary: Full replace.
      operationId: replacePrimitive
      parameters: 
        - $ref: "#/components/parameters/Id"
        - $ref: "#/components/parameters/XTraceId"
      requestBody: 
        required: true
        content: 
          application/json: 
            schema: 
              $ref: "#/components/schemas/PrimitiveBag"
      responses: 
        "200": 
          description: Replaced.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/PrimitiveBag"
    patch: 
      tags: 
        - primitives
      summary: "Partial update, with an operation-level override of \`id\`."
      operationId: patchPrimitive
      parameters: 
        - name: id
          in: path
          description: Overrides the path-item declaration with a looser schema.
          required: true
          schema: 
            type: string
        - $ref: "#/components/parameters/XTraceId"
      requestBody: 
        description: Sparse patch document.
        required: false
        content: 
          application/json: 
            schema: 
              type: object
              properties: 
                label: 
                  type: string
      responses: 
        "200": 
          description: Patched.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/PrimitiveBag"
    delete: 
      tags: 
        - primitives
      summary: "Delete, no response body."
      operationId: deletePrimitive
      parameters: 
        - $ref: "#/components/parameters/Id"
        - $ref: "#/components/parameters/XTraceId"
      responses: 
        "204": 
          description: Deleted.
        "404": 
          $ref: "#/components/responses/NotFound"
    options: 
      tags: 
        - primitives
      summary: Allowed methods.
      operationId: optionsPrimitive
      parameters: 
        - $ref: "#/components/parameters/Id"
        - $ref: "#/components/parameters/XTraceId"
      responses: 
        "204": 
          description: See the Allow header.
          headers: 
            Allow: 
              required: true
              schema: 
                type: string
    head: 
      tags: 
        - primitives
      summary: Existence probe.
      operationId: headPrimitive
      parameters: 
        - $ref: "#/components/parameters/Id"
        - $ref: "#/components/parameters/XTraceId"
      responses: 
        "200": 
          description: Exists.
        "404": 
          $ref: "#/components/responses/NotFound"
  /bodies/json: 
    post: 
      tags: 
        - bodies
      summary: A plain JSON body.
      operationId: postJsonBody
      requestBody: 
        description: The widget to create.
        required: true
        content: 
          application/json: 
            schema: 
              $ref: "#/components/schemas/Widget"
      responses: 
        "201": 
          description: Created.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/Widget"
  /bodies/multi: 
    post: 
      tags: 
        - bodies
      summary: "One operation, many request media types."
      operationId: postMultiBody
      requestBody: 
        required: true
        content: 
          application/json: 
            schema: 
              $ref: "#/components/schemas/Widget"
          application/x-www-form-urlencoded: 
            schema: 
              type: object
              properties: 
                name: 
                  type: string
                count: 
                  type: integer
              required: 
                - name
          multipart/form-data: 
            schema: 
              type: object
              properties: 
                file: 
                  type: string
                  format: binary
                caption: 
                  type: string
                tags: 
                  type: array
                  items: 
                    type: string
              required: 
                - file
            encoding: 
              file: 
                contentType: application/octet-stream
              tags: 
                style: form
                explode: true
          text/plain: 
            schema: 
              type: string
          application/octet-stream: 
            schema: 
              type: string
              format: binary
      responses: 
        "202": 
          description: Accepted.
  /bodies/optional: 
    post: 
      tags: 
        - bodies
      summary: An optional request body.
      operationId: postOptionalBody
      requestBody: 
        required: false
        content: 
          application/json: 
            schema: 
              type: object
              properties: 
                note: 
                  type: string
      responses: 
        "200": 
          description: Fine either way.
  /bodies/ref: 
    put: 
      tags: 
        - bodies
      summary: A body declared through components.requestBodies.
      operationId: putRefBody
      requestBody: 
        $ref: "#/components/requestBodies/WidgetBody"
      responses: 
        "200": 
          description: Stored.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/Widget"
  /meta/bare: 
    get: 
      tags: 
        - meta
      summary: "No parameters, no body, a single bodiless response."
      operationId: getBare
      responses: 
        "204": 
          description: Nothing to say.
  /meta/deprecated: 
    get: 
      tags: 
        - meta
        - primitives
      summary: A deprecated operation with several tags.
      description: "Multi-paragraph description.\\n\\nThe second paragraph must survive intact, including \`code spans\`,\\nan @-sign in \`@scope/name\`, and a trailing colon:"
      externalDocs: 
        url: https://example.test/docs/deprecated
        description: Migration guide
      operationId: getDeprecated
      responses: 
        "200": 
          description: Still works.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/Widget"
      deprecated: true
  /meta/description-only: 
    get: 
      tags: 
        - meta
      summary: ""
      description: An operation with a description but no summary.
      operationId: getDescriptionOnly
      responses: 
        "200": 
          description: OK.
          content: 
            application/json: 
              schema: 
                type: string
  /responses/default: 
    get: 
      tags: 
        - responses
      summary: Only a default response.
      operationId: getDefaultResponse
      responses: 
        default: 
          description: Anything at all.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/Error"
  /responses/examples: 
    get: 
      tags: 
        - responses
      summary: Content-level example and examples.
      operationId: getResponseExamples
      responses: 
        "200": 
          description: One example.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/Widget"
              example: 
                id: w_1
                name: Bolt
                size: 3
        "409": 
          description: Several named examples.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/Error"
              examples: 
                duplicate: 
                  summary: Already exists
                  value: 
                    code: duplicate
                    message: widget already exists
                locked: 
                  summary: Locked by another writer
                  value: 
                    code: locked
                    message: widget is locked
                fromComponents: 
                  summary: A shared error example
                  value: 
                    code: shared
                    message: referenced through components.examples
  /responses/headers: 
    get: 
      tags: 
        - responses
      summary: "Response headers, required and optional."
      operationId: getResponseHeaders
      responses: 
        "200": 
          description: With headers.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/Widget"
          headers: 
            X-Request-Id: 
              description: Correlation id.
              required: true
              schema: 
                type: string
                format: uuid
            X-Rate-Limit: 
              description: Calls left in the window.
              schema: 
                type: integer
            X-Cached: 
              schema: 
                type: boolean
            X-Ref-Header: 
              description: Remaining calls in the current window.
              schema: 
                type: integer
  /responses/links: 
    post: 
      tags: 
        - responses
      summary: A response carrying links.
      operationId: postWithLinks
      requestBody: 
        required: true
        content: 
          application/json: 
            schema: 
              $ref: "#/components/schemas/Widget"
      responses: 
        "201": 
          description: "Created, with a link to the read endpoint."
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/Widget"
          headers: 
            Location: 
              required: true
              schema: 
                type: string
                format: uri
          links: 
            GetWidget: 
              operationId: getPrimitive
              parameters: 
                id: "$response.body#/id"
  /responses/media: 
    get: 
      tags: 
        - responses
      summary: "One status, several response media types."
      operationId: getResponseMedia
      responses: 
        "200": 
          description: Pick your representation.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/Widget"
            text/html: 
              schema: 
                type: string
            text/plain: 
              schema: 
                type: string
            application/octet-stream: 
              schema: 
                type: string
                format: binary
  /responses/range: 
    get: 
      tags: 
        - responses
      summary: A wildcard status range.
      operationId: getRangeResponse
      responses: 
        5XX: 
          description: Any server error.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/Error"
  /responses/statuses: 
    get: 
      tags: 
        - responses
      summary: A wide spread of status codes.
      operationId: getStatuses
      responses: 
        "200": 
          description: OK with a body.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/Widget"
        "201": 
          description: Created with a body.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/Widget"
        "204": 
          description: No content at all.
        "301": 
          description: "Moved, no body."
        "304": 
          description: "Not modified, no body."
        "400": 
          $ref: "#/components/responses/ValidationError"
        "401": 
          $ref: "#/components/responses/Unauthorized"
        "404": 
          $ref: "#/components/responses/NotFound"
        "500": 
          description: Server error.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/Error"
  /security/alternatives: 
    get: 
      tags: 
        - security
      summary: Either bearer or API key.
      operationId: getAlternativeSecured
      responses: 
        "200": 
          description: OK.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/Widget"
      security: 
        - bearerAuth: 
            []
        - apiKeyAuth: 
            []
  /security/apikey: 
    get: 
      tags: 
        - security
      summary: API key auth.
      operationId: getApiKeySecured
      responses: 
        "200": 
          description: OK.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/Widget"
      security: 
        - apiKeyAuth: 
            []
  /security/bearer: 
    get: 
      tags: 
        - security
      summary: Bearer auth with scopes.
      operationId: getBearerSecured
      responses: 
        "200": 
          description: OK.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/Widget"
        "401": 
          $ref: "#/components/responses/Unauthorized"
      security: 
        - bearerAuth: 
            - read:widgets
  /security/oauth: 
    get: 
      tags: 
        - security
      summary: OAuth2 with two scopes.
      operationId: getOauthSecured
      responses: 
        "200": 
          description: OK.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/Widget"
      security: 
        - oauth2Auth: 
            - read:widgets
            - write:widgets
  /security/public: 
    get: 
      tags: 
        - security
      summary: "Explicitly public, overriding the global requirement."
      operationId: getPublic
      responses: 
        "200": 
          description: OK.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/Widget"
      security: 
        []
  "/v2/admin/users/{userId}/sessions/{sessionId}": 
    get: 
      tags: 
        - admin
      summary: "Deeply nested path, two path parameters."
      operationId: getAdminSession
      responses: 
        "200": 
          description: The session.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/Session"
        "403": 
          description: Forbidden.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/Error"
      security: 
        - bearerAuth: 
            - admin
    delete: 
      tags: 
        - admin
      summary: Revoke a session.
      operationId: deleteAdminSession
      responses: 
        "204": 
          description: Revoked.
      security: 
        - bearerAuth: 
            - admin
  "/{slug}": 
    get: 
      tags: 
        - meta
      summary: A root-level parameterised path.
      operationId: getBySlug
      responses: 
        "200": 
          description: Resolved.
          content: 
            application/json: 
              schema: 
                $ref: "#/components/schemas/Widget"
      security: 
        []
components: 
  securitySchemes: 
    bearerAuth: 
      type: http
      scheme: bearer
      bearerFormat: JWT
      description: A signed JWT.
    apiKeyAuth: 
      type: apiKey
      in: header
      name: X-Api-Key
    basicAuth: 
      type: http
      scheme: basic
    oauth2Auth: 
      type: oauth2
      flows: 
        authorizationCode: 
          authorizationUrl: https://example.test/oauth/authorize
          tokenUrl: https://example.test/oauth/token
          scopes: 
            read:widgets: Read widgets
            write:widgets: Write widgets
  schemas: 
    Identified: 
      type: object
      properties: 
        id: 
          type: string
          format: uuid
      required: 
        - id
    Timestamped: 
      type: object
      properties: 
        createdAt: 
          type: string
          format: date-time
        updatedAt: 
          type: string
          format: date-time
      required: 
        - createdAt
    Cat: 
      type: object
      properties: 
        meows: 
          type: boolean
      required: 
        - meows
    Dog: 
      type: object
      properties: 
        barks: 
          type: boolean
      required: 
        - barks
    Pet: 
      anyOf: 
        - allOf: 
            - type: object
              properties: 
                petType: 
                  type: string
                  enum: 
                    - cat
              required: 
                - petType
            - $ref: "#/components/schemas/Cat"
        - allOf: 
            - type: object
              properties: 
                petType: 
                  type: string
                  enum: 
                    - dog
              required: 
                - petType
            - $ref: "#/components/schemas/Dog"
    Nested: 
      description: Objects inside arrays inside objects.
      type: object
      properties: 
        root: 
          type: object
          properties: 
            label: 
              type: string
            branches: 
              type: array
              items: 
                type: object
                properties: 
                  leaves: 
                    type: array
                    items: 
                      type: array
                      items: 
                        type: string
                required: 
                  - leaves
          required: 
            - branches
        matrix: 
          type: array
          items: 
            type: array
            items: 
              type: number
      required: 
        - root
    NullableBag: 
      type: object
      properties: 
        requiredNullable: 
          type: string
          nullable: true
        optionalNullable: 
          type: integer
          nullable: true
        optionalNonNullable: 
          type: string
        nullableArray: 
          type: array
          items: 
            type: string
          nullable: true
        arrayOfNullable: 
          type: array
          items: 
            type: string
            nullable: true
      required: 
        - requiredNullable
    StringFormats: 
      description: One property per OpenAPI string format.
      type: object
      properties: 
        date: 
          type: string
          format: date
        dateTime: 
          type: string
          format: date-time
        password: 
          type: string
          format: password
        byte: 
          type: string
          format: byte
        binary: 
          type: string
          format: binary
        email: 
          type: string
          format: email
        uuid: 
          type: string
          format: uuid
        uri: 
          type: string
          format: uri
        hostname: 
          type: string
          format: hostname
        ipv4: 
          type: string
          format: ipv4
        ipv6: 
          type: string
          format: ipv6
    MapObject: 
      description: A free-form map declared through additionalProperties.
      type: object
      additionalProperties: 
        type: string
    ReadWriteOnly: 
      type: object
      properties: 
        id: 
          type: string
          readOnly: true
        password: 
          type: string
          writeOnly: true
    Widget: 
      allOf: 
        - $ref: "#/components/schemas/Identified"
        - type: object
          properties: 
            name: 
              type: string
              minLength: 1
            size: 
              type: integer
              minimum: 0
              maximum: 10
            tags: 
              type: array
              items: 
                type: string
            kind: 
              type: string
              enum: 
                - bolt
                - nut
                - washer
              default: bolt
          required: 
            - name
            - size
    PrimitiveBag: 
      title: Primitive bag
      description: One property per scalar shape.
      type: object
      properties: 
        str: 
          description: "A bounded, patterned string."
          type: string
          pattern: "^[A-Za-z0-9 ]+$"
          minLength: 1
          maxLength: 64
        int: 
          type: integer
          format: int32
          minimum: 0
          maximum: 2147483647
        num: 
          type: number
          format: float
          minimum: 0
          exclusiveMinimum: true
        bool: 
          type: boolean
        list: 
          type: array
          items: 
            type: string
          minItems: 0
          maxItems: 100
          uniqueItems: true
        obj: 
          type: object
          properties: 
            key: 
              type: string
            value: 
              type: string
          required: 
            - key
        optionalStr: 
          type: string
        anything: 
          {}
        defaulted: 
          type: string
          default: none
        exampled: 
          type: string
          example: sample-value
      required: 
        - str
        - int
        - num
        - bool
        - list
        - obj
    Error: 
      type: object
      properties: 
        code: 
          type: string
        message: 
          type: string
        details: 
          description: "Free-form, no type on purpose."
      required: 
        - code
        - message
    Session: 
      type: object
      properties: 
        id: 
          type: string
          format: uuid
        userId: 
          type: string
          format: uuid
        startedAt: 
          type: string
          format: date-time
        agent: 
          type: string
      required: 
        - id
        - userId
        - startedAt
  parameters: 
    Page: 
      name: page
      in: query
      description: 1-based page number.
      schema: 
        type: integer
        minimum: 1
        default: 1
    PageSize: 
      name: pageSize
      in: query
      description: Items per page.
      schema: 
        type: integer
        minimum: 1
        maximum: 100
        default: 25
    Id: 
      name: id
      in: path
      description: "Path-item level parameter, inherited by every operation."
      required: true
      schema: 
        type: string
        format: uuid
    XTraceId: 
      name: X-Trace-Id
      in: header
      description: Client-supplied trace id.
      schema: 
        type: string
        format: uuid
  requestBodies: 
    WidgetBody: 
      description: "A widget payload, reused across operations."
      required: true
      content: 
        application/json: 
          schema: 
            $ref: "#/components/schemas/Widget"
  responses: 
    ValidationError: 
      description: The request body did not validate.
      content: 
        application/json: 
          schema: 
            type: object
            properties: 
              code: 
                type: string
              errors: 
                type: array
                items: 
                  type: object
                  properties: 
                    path: 
                      type: string
                    message: 
                      type: string
                  required: 
                    - path
                    - message
            required: 
              - code
              - errors
    NotFound: 
      description: The resource does not exist.
      content: 
        application/json: 
          schema: 
            $ref: "#/components/schemas/Error"
          example: 
            code: not_found
            message: no such widget
    Unauthorized: 
      description: Missing or invalid credentials.
      content: 
        application/json: 
          schema: 
            $ref: "#/components/schemas/Error"
      headers: 
        WWW-Authenticate: 
          description: The authentication scheme to use.
          required: true
          schema: 
            type: string
        Retry-After: 
          description: Remaining calls in the current window.
          schema: 
            type: integer"
`;

exports[`openapi exhaustive: generate spec regenerated json spec matches the snapshot 1`] = `
"{
  "openapi": "3.0.3",
  "info": {
    "title": "Exhaustive Spec",
    "description": "Coverage fixture for the OpenAPI parser and serializer.\\n\\nIt contains one endpoint family per construct family: primitives,\\ncomposition, bodies, responses, parameters, security and metadata.\\n",
    "contact": {
      "name": "Spec Bot",
      "url": "https://example.test/contact",
      "email": "spec@example.test"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "4.2.1",
    "termsOfService": "https://example.test/tos"
  },
  "servers": [
    {
      "url": "https://api.example.test/v1",
      "description": "Production"
    },
    {
      "url": "https://{tenant}.staging.example.test/v1",
      "description": "Staging, per tenant",
      "variables": {
        "tenant": {
          "default": "acme",
          "enum": [
            "acme",
            "globex"
          ],
          "description": "Tenant subdomain"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "primitives",
      "description": "Scalar types, formats and constraints."
    },
    {
      "name": "composition",
      "description": "allOf / oneOf / anyOf / discriminator."
    },
    {
      "name": "bodies",
      "description": "Request body media types."
    },
    {
      "name": "responses",
      "description": "Status codes, headers, examples, links."
    },
    {
      "name": "params",
      "description": "Parameter locations and styles."
    },
    {
      "name": "security",
      "description": "Security schemes and scopes."
    },
    {
      "name": "meta",
      "description": "Operation metadata."
    },
    {
      "name": "admin",
      "description": "Deeply nested scope."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "externalDocs": {
    "url": "https://example.test/docs",
    "description": "Full handbook"
  },
  "paths": {
    "/composition": {
      "post": {
        "tags": [
          "composition"
        ],
        "summary": "Composed schemas in and out.",
        "description": "Exercises allOf, oneOf, anyOf, discriminators and deep nesting.",
        "operationId": "composeShapes",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "intersected": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/Identified"
                      },
                      {
                        "$ref": "#/components/schemas/Timestamped"
                      }
                    ]
                  },
                  "union": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/Cat"
                      },
                      {
                        "$ref": "#/components/schemas/Dog"
                      }
                    ]
                  },
                  "loose": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  },
                  "singleAllOf": {
                    "$ref": "#/components/schemas/Identified"
                  },
                  "singleOneOf": {
                    "type": "string"
                  },
                  "negated": {}
                },
                "required": [
                  "intersected",
                  "union",
                  "loose"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The discriminated result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pet"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/composition/nested": {
      "get": {
        "tags": [
          "composition"
        ],
        "summary": "Deeply nested objects and arrays.",
        "operationId": "getNested",
        "responses": {
          "200": {
            "description": "A nested tree.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Nested"
                }
              }
            }
          }
        }
      }
    },
    "/composition/nullable": {
      "get": {
        "tags": [
          "composition"
        ],
        "summary": "Nullable in every position.",
        "operationId": "getNullable",
        "responses": {
          "200": {
            "description": "Nulls everywhere.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NullableBag"
                }
              }
            }
          }
        }
      }
    },
    "/formats": {
      "get": {
        "tags": [
          "composition"
        ],
        "summary": "String formats, free-form maps and read/write-only properties.",
        "operationId": "getFormats",
        "responses": {
          "200": {
            "description": "The kitchen sink of schema annotations.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "formats": {
                      "$ref": "#/components/schemas/StringFormats"
                    },
                    "map": {
                      "$ref": "#/components/schemas/MapObject"
                    },
                    "readWrite": {
                      "$ref": "#/components/schemas/ReadWriteOnly"
                    }
                  },
                  "required": [
                    "formats"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/params/shared": {
      "get": {
        "tags": [
          "params"
        ],
        "summary": "Reuses the same page parameters, so they get promoted.",
        "operationId": "getSharedParams",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "A page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Widget"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/params/{group}/items/{itemId}": {
      "get": {
        "tags": [
          "params"
        ],
        "summary": "Path, query, header and cookie parameters together.",
        "operationId": "getParamMatrix",
        "parameters": [
          {
            "name": "group",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sort key, defaulted.",
            "schema": {
              "type": "string",
              "enum": [
                "name",
                "size",
                "createdAt"
              ],
              "default": "name"
            }
          },
          {
            "name": "expand",
            "in": "query",
            "description": "Repeated query parameter.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "An object parameter serialized as deepObject.",
            "style": "deepObject",
            "explode": true,
            "schema": {
              "type": "object",
              "properties": {
                "lat": {
                  "type": "number"
                },
                "lon": {
                  "type": "number"
                }
              }
            }
          },
          {
            "name": "pipes",
            "in": "query",
            "description": "A pipe-delimited array parameter.",
            "style": "pipeDelimited",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "legacy",
            "in": "query",
            "description": "On the way out.",
            "deprecated": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "contentParam",
            "in": "query",
            "description": "A parameter typed through \`content\` rather than \`schema\`.",
            "style": "deepObject",
            "explode": true,
            "schema": {
              "type": "object",
              "properties": {
                "lat": {
                  "type": "number"
                },
                "lon": {
                  "type": "number"
                }
              }
            }
          },
          {
            "name": "X-Tenant",
            "in": "header",
            "description": "Tenant selector.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "session",
            "in": "cookie",
            "description": "Session cookie.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matrix echoed back.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Widget"
                }
              }
            }
          }
        }
      }
    },
    "/primitives": {
      "get": {
        "tags": [
          "primitives"
        ],
        "summary": "Every scalar type as a query parameter.",
        "description": "Covers string/number/integer/boolean/array query parameters with the\\nfull set of JSON Schema constraints Galbe knows how to express.",
        "operationId": "listPrimitives",
        "parameters": [
          {
            "name": "plainString",
            "in": "query",
            "description": "A string with no constraint at all.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "boundedString",
            "in": "query",
            "description": "A string with length bounds and a pattern.",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$",
              "minLength": 3,
              "maxLength": 24
            }
          },
          {
            "name": "formattedString",
            "in": "query",
            "description": "A string carrying a format.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "defaultedString",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "fallback"
            }
          },
          {
            "name": "enumString",
            "in": "query",
            "description": "A closed set of string values.",
            "schema": {
              "type": "string",
              "enum": [
                "alpha",
                "beta",
                "gamma"
              ]
            }
          },
          {
            "name": "singleEnumString",
            "in": "query",
            "description": "A one-value enum, i.e. a literal.",
            "schema": {
              "type": "string",
              "enum": [
                "only"
              ]
            }
          },
          {
            "name": "boundedInteger",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0,
              "maximum": 100
            }
          },
          {
            "name": "exclusiveInteger",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1,
              "exclusiveMinimum": true,
              "maximum": 999,
              "exclusiveMaximum": true
            }
          },
          {
            "name": "boundedNumber",
            "in": "query",
            "schema": {
              "type": "number",
              "format": "double",
              "minimum": -1.5,
              "maximum": 1.5
            }
          },
          {
            "name": "multipleOfNumber",
            "in": "query",
            "schema": {
              "type": "number",
              "multipleOf": 0.25
            }
          },
          {
            "name": "flag",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "stringList",
            "in": "query",
            "description": "An array with item bounds and uniqueness.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "maxItems": 10,
              "uniqueItems": true
            }
          },
          {
            "name": "enumIntegerList",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "enum": [
                  1,
                  2,
                  3
                ]
              }
            }
          },
          {
            "name": "anySchema",
            "in": "query",
            "description": "No type at all, i.e. anything goes.",
            "schema": {}
          }
        ],
        "responses": {
          "200": {
            "description": "A page of primitives.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrimitiveBag"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/primitives/{id}": {
      "get": {
        "tags": [
          "primitives"
        ],
        "summary": "Read one, inheriting the path-item parameters.",
        "operationId": "getPrimitive",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          },
          {
            "$ref": "#/components/parameters/XTraceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrimitiveBag"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "tags": [
          "primitives"
        ],
        "summary": "Full replace.",
        "operationId": "replacePrimitive",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          },
          {
            "$ref": "#/components/parameters/XTraceId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrimitiveBag"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Replaced.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrimitiveBag"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "primitives"
        ],
        "summary": "Partial update, with an operation-level override of \`id\`.",
        "operationId": "patchPrimitive",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Overrides the path-item declaration with a looser schema.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/XTraceId"
          }
        ],
        "requestBody": {
          "description": "Sparse patch document.",
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Patched.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrimitiveBag"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "primitives"
        ],
        "summary": "Delete, no response body.",
        "operationId": "deletePrimitive",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          },
          {
            "$ref": "#/components/parameters/XTraceId"
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted."
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "options": {
        "tags": [
          "primitives"
        ],
        "summary": "Allowed methods.",
        "operationId": "optionsPrimitive",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          },
          {
            "$ref": "#/components/parameters/XTraceId"
          }
        ],
        "responses": {
          "204": {
            "description": "See the Allow header.",
            "headers": {
              "Allow": {
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "head": {
        "tags": [
          "primitives"
        ],
        "summary": "Existence probe.",
        "operationId": "headPrimitive",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          },
          {
            "$ref": "#/components/parameters/XTraceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Exists."
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/bodies/json": {
      "post": {
        "tags": [
          "bodies"
        ],
        "summary": "A plain JSON body.",
        "operationId": "postJsonBody",
        "requestBody": {
          "description": "The widget to create.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Widget"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Widget"
                }
              }
            }
          }
        }
      }
    },
    "/bodies/multi": {
      "post": {
        "tags": [
          "bodies"
        ],
        "summary": "One operation, many request media types.",
        "operationId": "postMultiBody",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Widget"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "count": {
                    "type": "integer"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "caption": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "file"
                ]
              },
              "encoding": {
                "file": {
                  "contentType": "application/octet-stream"
                },
                "tags": {
                  "style": "form",
                  "explode": true
                }
              }
            },
            "text/plain": {
              "schema": {
                "type": "string"
              }
            },
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted."
          }
        }
      }
    },
    "/bodies/optional": {
      "post": {
        "tags": [
          "bodies"
        ],
        "summary": "An optional request body.",
        "operationId": "postOptionalBody",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "note": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fine either way."
          }
        }
      }
    },
    "/bodies/ref": {
      "put": {
        "tags": [
          "bodies"
        ],
        "summary": "A body declared through components.requestBodies.",
        "operationId": "putRefBody",
        "requestBody": {
          "$ref": "#/components/requestBodies/WidgetBody"
        },
        "responses": {
          "200": {
            "description": "Stored.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Widget"
                }
              }
            }
          }
        }
      }
    },
    "/meta/bare": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "No parameters, no body, a single bodiless response.",
        "operationId": "getBare",
        "responses": {
          "204": {
            "description": "Nothing to say."
          }
        }
      }
    },
    "/meta/deprecated": {
      "get": {
        "tags": [
          "meta",
          "primitives"
        ],
        "summary": "A deprecated operation with several tags.",
        "description": "Multi-paragraph description.\\n\\nThe second paragraph must survive intact, including \`code spans\`,\\nan @-sign in \`@scope/name\`, and a trailing colon:",
        "externalDocs": {
          "url": "https://example.test/docs/deprecated",
          "description": "Migration guide"
        },
        "operationId": "getDeprecated",
        "responses": {
          "200": {
            "description": "Still works.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Widget"
                }
              }
            }
          }
        },
        "deprecated": true
      }
    },
    "/meta/description-only": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "",
        "description": "An operation with a description but no summary.",
        "operationId": "getDescriptionOnly",
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/responses/default": {
      "get": {
        "tags": [
          "responses"
        ],
        "summary": "Only a default response.",
        "operationId": "getDefaultResponse",
        "responses": {
          "default": {
            "description": "Anything at all.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/responses/examples": {
      "get": {
        "tags": [
          "responses"
        ],
        "summary": "Content-level example and examples.",
        "operationId": "getResponseExamples",
        "responses": {
          "200": {
            "description": "One example.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Widget"
                },
                "example": {
                  "id": "w_1",
                  "name": "Bolt",
                  "size": 3
                }
              }
            }
          },
          "409": {
            "description": "Several named examples.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "duplicate": {
                    "summary": "Already exists",
                    "value": {
                      "code": "duplicate",
                      "message": "widget already exists"
                    }
                  },
                  "locked": {
                    "summary": "Locked by another writer",
                    "value": {
                      "code": "locked",
                      "message": "widget is locked"
                    }
                  },
                  "fromComponents": {
                    "summary": "A shared error example",
                    "value": {
                      "code": "shared",
                      "message": "referenced through components.examples"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/responses/headers": {
      "get": {
        "tags": [
          "responses"
        ],
        "summary": "Response headers, required and optional.",
        "operationId": "getResponseHeaders",
