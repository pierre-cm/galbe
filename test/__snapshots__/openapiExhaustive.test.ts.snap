exports[`openapi exhaustive: generate code source schemas/commons.schema.ts 1`] = `
"import type { Static } from "galbe/schema";
import { $T } from "galbe";

export const Error = $T.object(
  {
    code: $T.string(),
    message: $T.string(),
    details: $T.optional(
      $T.any({ description: "Free-form, no type on purpose." }),
    ),
  },
  { id: "Error" },
);
export type Error = Static<typeof Error>;

export const Session = $T.object(
  {
    id: $T.string({ format: "uuid" }),
    userId: $T.string({ format: "uuid" }),
    startedAt: $T.string({ format: "date-time" }),
    agent: $T.optional($T.string()),
  },
  { id: "Session" },
);
export type Session = Static<typeof Session>;

export const ReadWriteOnly = $T.object(
  {
    id: $T.optional($T.string({ readOnly: true })),
    password: $T.optional($T.string({ writeOnly: true })),
  },
  { id: "ReadWriteOnly" },
);
export type ReadWriteOnly = Static<typeof ReadWriteOnly>;

export const MapObject = $T.record($T.string(), {
  id: "MapObject",
  description: "A free-form map declared through additionalProperties.",
});
export type MapObject = Static<typeof MapObject>;

export const NullableBag = $T.object(
  {
    requiredNullable: $T.nullable($T.string()),
    optionalNullable: $T.nullish($T.integer()),
    optionalNonNullable: $T.optional($T.string()),
    nullableArray: $T.nullish($T.array($T.string())),
    arrayOfNullable: $T.optional($T.array($T.nullable($T.string()))),
  },
  { id: "NullableBag" },
);
export type NullableBag = Static<typeof NullableBag>;

export const Nested = $T.object(
  {
    root: $T.object({
      label: $T.optional($T.string()),
      branches: $T.array(
        $T.object({ leaves: $T.array($T.array($T.string())) }),
      ),
    }),
    matrix: $T.optional($T.array($T.array($T.number()))),
  },
  { id: "Nested", description: "Objects inside arrays inside objects." },
);
export type Nested = Static<typeof Nested>;

export const Dog = $T.object({ barks: $T.boolean() }, { id: "Dog" });
export type Dog = Static<typeof Dog>;

export const Cat = $T.object({ meows: $T.boolean() }, { id: "Cat" });
export type Cat = Static<typeof Cat>;

export const Pet = $T.union(
  [
    $T.intersection([$T.object({ petType: $T.literal("cat") }), Cat]),
    $T.intersection([$T.object({ petType: $T.literal("dog") }), Dog]),
  ],
  { id: "Pet" },
);
export type Pet = Static<typeof Pet>;

export const Identified = $T.object(
  { id: $T.string({ format: "uuid" }) },
  { id: "Identified" },
);
export type Identified = Static<typeof Identified>;

export const Widget = $T.intersection(
  [
    Identified,
    $T.object({
      name: $T.string({ minLength: 1 }),
      size: $T.integer({ min: 0, max: 10 }),
      tags: $T.optional($T.array($T.string())),
      kind: $T.optional(
        $T.union(
          [$T.literal("bolt"), $T.literal("nut"), $T.literal("washer")],
          { default: "bolt" },
        ),
      ),
    }),
  ],
  { id: "Widget" },
);
export type Widget = Static<typeof Widget>;

export const Timestamped = $T.object(
  {
    createdAt: $T.string({ format: "date-time" }),
    updatedAt: $T.optional($T.string({ format: "date-time" })),
  },
  { id: "Timestamped" },
);
export type Timestamped = Static<typeof Timestamped>;

export const StringFormats = $T.object(
  {
    date: $T.optional($T.string({ format: "date" })),
    dateTime: $T.optional($T.string({ format: "date-time" })),
    password: $T.optional($T.string({ format: "password" })),
    byte: $T.optional($T.string({ format: "byte" })),
    binary: $T.optional($T.byteArray()),
    email: $T.optional($T.string({ format: "email" })),
    uuid: $T.optional($T.string({ format: "uuid" })),
    uri: $T.optional($T.string({ format: "uri" })),
    hostname: $T.optional($T.string({ format: "hostname" })),
    ipv4: $T.optional($T.string({ format: "ipv4" })),
    ipv6: $T.optional($T.string({ format: "ipv6" })),
  },
  {
    id: "StringFormats",
    description: "One property per OpenAPI string format.",
  },
);
export type StringFormats = Static<typeof StringFormats>;

export const PrimitiveBag = $T.object(
  {
    str: $T.string({
      description: "A bounded, patterned string.",
      minLength: 1,
      maxLength: 64,
      pattern: /^[A-Za-z0-9 ]+$/,
    }),
    int: $T.integer({ min: 0, max: 2147483647, format: "int32" }),
    num: $T.number({ exclusiveMin: 0, format: "float" }),
    bool: $T.boolean(),
    list: $T.array($T.string(), { minLength: 0, maxLength: 100, unique: true }),
    obj: $T.object({ key: $T.string(), value: $T.optional($T.string()) }),
    optionalStr: $T.optional($T.string()),
    anything: $T.optional($T.any()),
    defaulted: $T.optional($T.string({ default: "none" })),
    exampled: $T.optional($T.string({ examples: "sample-value" })),
  },
  {
    id: "PrimitiveBag",
    title: "Primitive bag",
    description: "One property per scalar shape.",
  },
);
export type PrimitiveBag = Static<typeof PrimitiveBag>;
"
`;

exports[`openapi exhaustive: generate code source schemas/composition.schema.ts 1`] = `
"import { $T } from "galbe";

import { Identified, Timestamped, Cat, Dog, Pet } from "./commons.schema";
import { ValidationError } from "./responses.schema";

export const ComposeShapes = {
  body: {
    "application/json": $T.object({
      intersected: $T.intersection([Identified, Timestamped], {}),
      union: $T.oneOf([Cat, Dog]),
      loose: $T.anyOf([$T.string(), $T.integer()]),
      singleAllOf: $T.optional(Identified),
      singleOneOf: $T.optional($T.string()),
      negated: $T.optional($T.any()),
    }),
  },
  response: {
    200: { "application/json": Pet, description: "The discriminated result." },
    422: ValidationError,
  },
};
"
`;

