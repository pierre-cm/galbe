exports[`openapi exhaustive: generate code source schemas/primitives.schema.ts 1`] = `
"import { $T } from "galbe";

import { PrimitiveBag } from "./commons.schema";
import { NotFound } from "./responses.schema";

export const ListPrimitives = {
  query: {
    plainString: $T.optional(
      $T.string({ description: "A string with no constraint at all." }),
    ),
    boundedString: $T.string({
      description: "A string with length bounds and a pattern.",
      minLength: 3,
      maxLength: 24,
      pattern: /^[a-z][a-z0-9_-]*$/,
    }),
    formattedString: $T.optional(
      $T.string({
        description: "A string carrying a format.",
        format: "date-time",
      }),
    ),
    defaultedString: $T.optional($T.string({ default: "fallback" })),
    enumString: $T.optional(
      $T.union([$T.literal("alpha"), $T.literal("beta"), $T.literal("gamma")], {
        description: "A closed set of string values.",
      }),
    ),
    singleEnumString: $T.optional(
      $T.literal("only", { description: "A one-value enum, i.e. a literal." }),
    ),
    boundedInteger: $T.optional(
      $T.integer({ min: 0, max: 100, format: "int32" }),
    ),
    exclusiveInteger: $T.optional(
      $T.integer({ exclusiveMax: 999, exclusiveMin: 1, format: "int64" }),
    ),
    boundedNumber: $T.optional(
      $T.number({ min: -1.5, max: 1.5, format: "double" }),
    ),
    multipleOfNumber: $T.optional($T.number({ multipleOf: 0.25 })),
    flag: $T.optional($T.boolean({ default: false })),
    stringList: $T.optional(
      $T.array($T.string(), {
        description: "An array with item bounds and uniqueness.",
        minLength: 1,
        maxLength: 10,
        unique: true,
      }),
    ),
    enumIntegerList: $T.optional(
      $T.array($T.union([$T.literal(1), $T.literal(2), $T.literal(3)])),
    ),
    anySchema: $T.optional(
      $T.any({ description: "No type at all, i.e. anything goes." }),
    ),
  },
  response: {
    200: {
      "application/json": PrimitiveBag,
      description: "A page of primitives.",
    },
  },
};

export const GetPrimitive = {
  headers: {
    "X-Trace-Id": $T.optional(
      $T.string({ description: "Client-supplied trace id.", format: "uuid" }),
    ),
  },
  params: {
    id: $T.string({
      description: "Path-item level parameter, inherited by every operation.",
      format: "uuid",
    }),
  },
  response: {
    200: { "application/json": PrimitiveBag, description: "Found." },
    404: NotFound,
  },
};

export const ReplacePrimitive = {
  headers: {
    "X-Trace-Id": $T.optional(
      $T.string({ description: "Client-supplied trace id.", format: "uuid" }),
    ),
  },
  params: {
    id: $T.string({
      description: "Path-item level parameter, inherited by every operation.",
      format: "uuid",
    }),
  },
  body: { "application/json": PrimitiveBag },
  response: {
    200: { "application/json": PrimitiveBag, description: "Replaced." },
  },
};

export const PatchPrimitive = {
  headers: {
    "X-Trace-Id": $T.optional(
      $T.string({ description: "Client-supplied trace id.", format: "uuid" }),
    ),
  },
  params: {
    id: $T.string({
      description: "Overrides the path-item declaration with a looser schema.",
    }),
  },
  body: {
    "application/json": $T.optional(
      $T.object({ label: $T.optional($T.string()) }),
    ),
    description: "Sparse patch document.",
  },
  response: {
    200: { "application/json": PrimitiveBag, description: "Patched." },
  },
};

export const DeletePrimitive = {
  headers: {
    "X-Trace-Id": $T.optional(
      $T.string({ description: "Client-supplied trace id.", format: "uuid" }),
    ),
  },
  params: {
    id: $T.string({
      description: "Path-item level parameter, inherited by every operation.",
      format: "uuid",
    }),
  },
  response: { 204: $T.null({ description: "Deleted." }), 404: NotFound },
};

export const OptionsPrimitive = {
  headers: {
    "X-Trace-Id": $T.optional(
      $T.string({ description: "Client-supplied trace id.", format: "uuid" }),
    ),
  },
  params: {
    id: $T.string({
      description: "Path-item level parameter, inherited by every operation.",
      format: "uuid",
    }),
  },
  response: {
    204: {
      ...$T.null({ description: "See the Allow header." }),
      responseHeaders: { Allow: $T.string() },
    },
  },
};

export const HeadPrimitive = {
  headers: {
    "X-Trace-Id": $T.optional(
      $T.string({ description: "Client-supplied trace id.", format: "uuid" }),
    ),
  },
  params: {
    id: $T.string({
      description: "Path-item level parameter, inherited by every operation.",
      format: "uuid",
    }),
  },
  response: { 200: $T.null({ description: "Exists." }), 404: NotFound },
};
"
`;

