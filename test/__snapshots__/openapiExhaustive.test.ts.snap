"import { $T } from "galbe";

import { Widget } from "./commons.schema";

export const GetParamMatrix = {
  headers: { "X-Tenant": $T.string({ description: "Tenant selector." }) },
  params: { group: $T.string(), itemId: $T.integer() },
  query: {
    page: $T.optional(
      $T.integer({ description: "1-based page number.", default: 1, min: 1 }),
    ),
    pageSize: $T.optional(
      $T.integer({
        description: "Items per page.",
        default: 25,
        min: 1,
        max: 100,
      }),
    ),
    sort: $T.optional(
      $T.union(
        [$T.literal("name"), $T.literal("size"), $T.literal("createdAt")],
        { description: "Sort key, defaulted.", default: "name" },
      ),
    ),
    expand: $T.optional(
      $T.array($T.string(), { description: "Repeated query parameter." }),
    ),
    filter: $T.optional(
      $T.object(
        { lat: $T.optional($T.number()), lon: $T.optional($T.number()) },
        { description: "An object parameter serialized as deepObject." },
      ),
    ),
    pipes: $T.optional(
      $T.array($T.string(), {
        description: "A pipe-delimited array parameter.",
        split: "|",
      }),
    ),
    legacy: $T.optional(
      $T.string({ description: "On the way out.", deprecated: true }),
    ),
    contentParam: $T.optional(
      $T.object(
        { lat: $T.optional($T.number()), lon: $T.optional($T.number()) },
        {
          description:
            "A parameter typed through \`content\` rather than \`schema\`.",
        },
      ),
    ),
  },
  cookies: {
    session: $T.optional($T.string({ description: "Session cookie." })),
  },
  response: {
    200: { "application/json": Widget, description: "Matrix echoed back." },
  },
};
"
`;

