exports[`openapi exhaustive: generate code source schemas/responses.schema.ts 1`] = `
"import type { Static } from "galbe/schema";
import { $T } from "galbe";
import { Error } from "./commons.schema";

export const ValidationError = {
  "application/json": $T.object({
    code: $T.string(),
    errors: $T.array($T.object({ path: $T.string(), message: $T.string() })),
  }),
  _responseId: "ValidationError",
  description: "The request body did not validate.",
};
export type ValidationError = Static<
  (typeof ValidationError)["application/json"]
>;

export const Unauthorized = {
  "application/json": Error,
  _responseId: "Unauthorized",
  description: "Missing or invalid credentials.",
  responseHeaders: {
    "WWW-Authenticate": $T.string({
      description: "The authentication scheme to use.",
    }),
    "Retry-After": $T.optional(
      $T.integer({ description: "Remaining calls in the current window." }),
    ),
  },
};
export type Unauthorized = Static<(typeof Unauthorized)["application/json"]>;

export const NotFound = {
  "application/json": Error,
  _responseId: "NotFound",
  description: "The resource does not exist.",
  example: { code: "not_found", message: "no such widget" },
};
export type NotFound = Static<(typeof NotFound)["application/json"]>;
"
`;

