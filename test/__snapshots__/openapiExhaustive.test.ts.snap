    throw new NotImplementedError();
  });

  /**
   * Partial update, with an operation-level override of \`id\`.
   *
   * @operationId patchPrimitive
   * @tags primitives
   */
  g.patch("/primitives/:id", PatchPrimitive, (ctx) => {
    throw new NotImplementedError();
  });

  /**
   * Delete, no response body.
   *
   * @operationId deletePrimitive
   * @tags primitives
   */
  g.delete("/primitives/:id", DeletePrimitive, (ctx) => {
    throw new NotImplementedError();
  });

  /**
   * Allowed methods.
   *
   * @operationId optionsPrimitive
   * @tags primitives
   */
  g.options("/primitives/:id", OptionsPrimitive, (ctx) => {
    throw new NotImplementedError();
  });

  /**
   * Existence probe.
   *
   * @operationId headPrimitive
   * @tags primitives
   */
  g.head("/primitives/:id", HeadPrimitive, (ctx) => {
    throw new NotImplementedError();
  });
};
"
`;

