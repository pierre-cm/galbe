{
  "name": "galbe",
  "version": "0.15.5",
  "description": "Fast, lightweight and highly customizable JavaScript web framework based on Bun",
  "author": "Pierre Caillaud M (https://github.com/pierre-cm)",
  "type": "module",
  "bin": "./bin/cli.ts",
  "main": "./src/index.ts",
  "files": [
    "bin/",
    "scripts/",
    "src/"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./extras": "./src/extras.ts",
    "./utils": "./src/util.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pierre-cm/galbe"
  },
  "bugs": "https://github.com/pierre-cm/galbe/issues",
  "homepage": "https://galbe.dev",
  "keywords": [
    "bun",
    "http",
    "web",
    "framework",
    "server",
    "api"
  ],
  "license": "MIT",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false -p tsconfig.json && tsc --noEmit --emitDeclarationOnly false -p tsconfig.test.json",
    "release": "bun run scripts/release.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "openapi-types": "^12.1.3"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@swc/core": "^1.3.107",
    "@swc/wasm": "^1.4.0",
    "acorn": "^8.11.2",
    "acorn-walk": "^8.3.0",
    "commander": "^11.1.0"
  }
}
