{
  "name": "galbe",
  "version": "0.15.6",
  "description": "Fast, lightweight and highly customizable JavaScript web framework based on Bun",
  "author": "Pierre Caillaud M (https://github.com/pierre-cm)",
  "type": "module",
  "bin": "./bin/cli.ts",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "bin/",
    "src/"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./middlewares": {
      "types": "./src/middlewares.ts",
      "default": "./src/middlewares.ts"
    },
    "./middlewares/*": {
      "types": "./src/middlewares/*.ts",
      "default": "./src/middlewares/*.ts"
    },
    "./extras": {
      "types": "./src/extras.ts",
      "default": "./src/extras.ts"
    },
    "./utils": {
      "types": "./src/util.ts",
      "default": "./src/util.ts"
    }
  },
  "engines": {
    "bun": ">=1.2.21"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pierre-cm/galbe"
  },
  "bugs": "https://github.com/pierre-cm/galbe/issues",
  "homepage": "https://galbe.dev",
  "keywords": [
    "bun",
    "http",
    "web",
    "framework",
    "server",
    "api"
  ],
  "license": "MIT",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false -p tsconfig.json && tsc --noEmit --emitDeclarationOnly false -p tsconfig.test.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "bun run scripts/release.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "3.9.6"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@swc/wasm": "^1.4.0",
    "acorn": "^8.11.2",
    "acorn-walk": "^8.3.0",
    "commander": "^11.1.0",
    "openapi-types": "^12.1.3"
  }
}
